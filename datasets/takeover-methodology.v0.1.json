    },
    {
      "id": "reliability",
      "name": "可靠性",
      "weight": 0.2,
      "levels": [
        "有明确评估表明达不到最低验收要求",
        "只有受控成功演示",
        "有重复测试，适用范围较窄",
        "代表性测试达到预先定义的业务验收条件，披露失败情况",
        "有持续真实运行记录，并满足场景预设的稳定性与异常处理要求"
      ]
