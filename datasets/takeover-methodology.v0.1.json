        "目标用户可常规获取使用",
        "可持续接入目标工作流程，权限、运行方式等满足场景要求"
      ]
    },
    {
      "id": "adoption",
      "name": "实际应用",
      "weight": 0.2,
      "levels": [
        "有明确依据表明尚未进入真实使用",
        "有明确的真实用户试点",
        "有具名生产使用案例和具体工作流程",
        "多个独立组织持续生产使用，有可核实范围",
        "有包含总体与样本口径的广泛采用证据，满足场景预设门槛"
      ]
    }
  ],
  "assessmentRules": {
