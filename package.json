{
  "name": "openaiwill",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3456",
    "build": "next build",
    "start": "next start -p 3456",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "security:check": "python3 scripts/check-public-files.py",
    "security:staged": "python3 scripts/check-public-files.py --staged",
    "security:test": "python3 -m unittest discover -s scripts/tests -p 'test_public_files.py'",
    "check": "pnpm security:check && pnpm security:test && pnpm metadata:check && pnpm platform:test && pnpm platform:check && pnpm ontology:test && pnpm ontology:check && pnpm data:test:unit && pnpm crawl:test:unit && pnpm i18n:test && pnpm design:check && pnpm lint && pnpm typecheck && pnpm build",
    "metadata:check": "node scripts/check-metadata.mjs",
    "design:build": "node scripts/build-design-system.mjs",
    "design:check": "node scripts/check-design-system.mjs",
    "platform:build": "node scripts/build-platform-metadata.mjs",
    "platform:seal": "node scripts/seal-platform-release.mjs",
    "platform:test": "node --test scripts/tests/platform-data.test.mjs scripts/tests/platform-cli.test.mjs",
    "platform:check": "node scripts/check-platform-data.mjs",
    "ontology:build": "node scripts/build-ontology.mjs",
    "ontology:test": "node --test scripts/tests/ontology-data.test.mjs scripts/tests/ontology-release.test.mjs scripts/tests/ontology-package.test.mjs",
    "ontology:seal": "node scripts/seal-ontology.mjs",
    "ontology:projections": "node scripts/build-ontology-projections.mjs",
    "ontology:check": "node scripts/check-ontology.mjs && node scripts/check-ontology-schema.mjs",
    "data:setup": "python3 scripts/data-local.py setup",
    "data:up": "python3 scripts/data-local.py up",
    "data:status": "python3 scripts/data-local.py status",
    "data:down": "python3 scripts/data-local.py down",
    "data:psql": "python3 scripts/data-local.py psql",
    "data:migrate": "data/runtime/venv/bin/python scripts/data-pipeline.py migrate",
    "data:import:ontology": "data/runtime/venv/bin/python scripts/data-pipeline.py import-ontology",
    "data:ingest:x": "data/runtime/venv/bin/python scripts/data-pipeline.py ingest",
    "data:extract:events": "data/runtime/venv/bin/python scripts/data-pipeline.py extract-events",
    "data:ingest:events": "data/runtime/venv/bin/python scripts/data-pipeline.py ingest-events",
    "data:seed:ontology": "data/runtime/venv/bin/python scripts/data-pipeline.py seed-ontology-data",
    "data:route:events": "data/runtime/venv/bin/python scripts/data-pipeline.py route-events",
    "data:map:activities": "data/runtime/venv/bin/python scripts/data-pipeline.py map-activities",
    "data:map:markets": "data/runtime/venv/bin/python scripts/data-pipeline.py map-markets",
    "data:map:gates": "data/runtime/venv/bin/python scripts/data-pipeline.py map-gates",
    "data:activity:state": "data/runtime/venv/bin/python scripts/data-pipeline.py activity-state",
    "data:gate:state": "data/runtime/venv/bin/python scripts/data-pipeline.py gate-state",
    "data:publish:snapshot": "data/runtime/venv/bin/python scripts/data-pipeline.py publish-snapshot",
    "data:test:unit": "python3 -m unittest discover -s scripts/tests -p 'test_data_*unit.py'",
    "data:test": "data/runtime/venv/bin/python -m unittest discover -s scripts/tests -p 'test_data_*.py'",
    "crawl": "data/runtime/crawler-venv/bin/python local/x-crawler/crawler",
    "crawl:x": "data/runtime/crawler-venv/bin/python local/x-crawler/crawler timeline",
    "crawl:setup": "python3 -m venv data/runtime/crawler-venv && data/runtime/crawler-venv/bin/pip install -q -r local/x-crawler/requirements.txt",
    "crawl:test:unit": "if [ -d local/x-crawler/tests ]; then python3 -m unittest discover -s local/x-crawler/tests -p 'test_crawler_*unit.py'; else echo 'local crawler not present; crawler tests skipped'; fi",
    "i18n:test": "node --test scripts/tests/test_i18n_unit.mjs scripts/tests/test_site_labels_unit.mjs",
    "data:panel:import": "data/runtime/venv/bin/python scripts/data-pipeline.py panel-import",
    "data:panel:refresh": "data/runtime/venv/bin/python scripts/data-pipeline.py panel-refresh",
    "data:verify": "data/runtime/venv/bin/python scripts/data-pipeline.py verify",
    "data:official:import": "data/runtime/venv/bin/python scripts/data-pipeline.py official-import",
    "crawl:lookup": "data/runtime/crawler-venv/bin/python local/x-crawler/crawler lookup",
    "data:panel:lookup-import": "data/runtime/venv/bin/python scripts/data-pipeline.py panel-lookup-import",
    "data:relations:backfill": "data/runtime/venv/bin/python scripts/data-pipeline.py relations-backfill",
    "data:post-events": "data/runtime/venv/bin/python scripts/data-pipeline.py post-events",
    "data:identify:models": "data/runtime/venv/bin/python scripts/data-pipeline.py identify-models",
    "data:models:catalog": "data/runtime/venv/bin/python scripts/data-pipeline.py model-catalog"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.170.0",
    "ajv": "8.20.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "n3": "^2.9.1",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  }
}
